{
  "schema": 1,
  "name": "ricursive",
  "version": "0.0.1",
  "api_version": ">= 0.2.0",
  "entry": "ricursive_register",
  "registration_target": "gufo_ricursive",
  "depends": [],
  "platforms": [
    "linux"
  ],
  "providers": [
    {
      "id": "ricursive",
      "capability": "text_generation",
      "keys": [
        "gguf:ricursive"
      ],
      "model_ids": [
        "ricursive-skeleton"
      ],
      "speculative": [
        "dflash2"
      ],
      "target": "gufo_ricursive",
      "entry": "ricursive_provider_register",
      "serving": {
        "draft_options": {
          "dflash2": "--dflash-model"
        }
      }
    }
  ],
  "options": [
    {
      "name": "--context-cap",
      "type": "integer",
      "commands": ["serve", "bench", "prompt", "chat"],
      "providers": ["ricursive"],
      "help": "ricursive context cap in tokens (default 32768; the model's nominal 2,097,152 is never used). Full-attention layers cost 64 KiB per token at F16"
    },
    {
      "name": "--dflash-model",
      "type": "path",
      "commands": ["serve", "bench", "prompt"],
      "providers": ["ricursive"],
      "help": "DFlash2 draft model path for speculative decoding (ricursive: the drafter runs on the GPU; with RICURSIVE_BACKEND=cpu the scalar CPU reference, tiny models only)"
    },
    {
      "name": "--allow-chat-template-mismatch",
      "type": "boolean",
      "commands": ["serve", "bench", "prompt", "chat"],
      "providers": ["ricursive"],
      "help": "accept a GGUF whose chat template differs from the pinned Ripple template (prompts may then be wrong)"
    }
  ],
  "targets": {
    "gufo_ricursive": {
      "requires": []
    },
